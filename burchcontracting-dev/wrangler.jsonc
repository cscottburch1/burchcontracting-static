// Cloudflare Worker config for burchcontracting.com — see CLOUDFLARE-CUTOVER.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burchcontracting",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Exact file paths only. The automatic modes redirect with 307s and would
    // change live URLs (/about.html -> /about); cloudflare/worker.js handles
    // folders and redirects exactly as Hostinger did instead.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Lets the Worker import public/.htaccess, the single source of redirect
  // rules and security headers for both hosts.
  "rules": [{ "type": "Text", "globs": ["**/.htaccess"], "fallthrough": true }],

  "vars": {
    // Hostnames where /api/* and /.well-known/* are forwarded to Hostinger.
    "ORIGIN_HOSTS": "burchcontracting.com"
  },

  // Serves burchcontracting.com. The DNS record still points at Hostinger:
  // the route sends requests to this Worker first, and deleting the route
  // (Cloudflare dashboard → Workers & Pages → burchcontracting → Settings →
  // Domains & Routes) sends traffic straight back to Hostinger. Needs "Always
  // Use HTTPS" and a www → root Redirect Rule in the zone, because Hostinger
  // used to perform both redirects (CLOUDFLARE-CUTOVER.md, step 4).
  "routes": [{ "pattern": "burchcontracting.com/*", "zone_name": "burchcontracting.com" }],

  // workers.dev stays on because branch preview URLs require it. Every page's
  // canonical tag points at burchcontracting.com, so search engines don't
  // treat that copy as a second site.
  "workers_dev": true,
  "preview_urls": true,

  "observability": { "enabled": true }
}

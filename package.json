{
  "name": "burchcontracting-static",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node src/build/index.mjs",
    "build": "vite build && node scripts/apply-staging-noindex.mjs && node scripts/write-sitemap.mjs && node scripts/write-llms.mjs && node scripts/generate-cloudflare-files.mjs",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "check-build": "node scripts/check-build.mjs",
    "check-schema": "node scripts/check-schema.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-wrangler-config": "node scripts/check-wrangler-config.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wrangler": "^4.131.1"
  }
}
